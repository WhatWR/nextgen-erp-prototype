:8080 {
        encode zstd gzip
        @order_intake path /webhooks/line* /api/intake/*
        reverse_proxy @order_intake order-intake:8200
        reverse_proxy frontend:8080 {
                # Frappe realtime validates Origin and Host. Keep the internal
                # site hostname consistent while the browser uses localhost.
                header_up Host {$SITE_NAME}
        }
}
