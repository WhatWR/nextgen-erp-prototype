# Copy this file to .env.server on the server and replace every CHANGE_ME value.
# Never commit .env.server.

COMPOSE_PROJECT_NAME=nextgen-erp
ERPNEXT_VERSION=v16.20.0
NEXTGEN_IMAGE=nextgen-erp
NEXTGEN_TAG=v16.20.0

# Domainless/ngrok mode is the default. SITE_NAME is ERPNext's internal site ID.
SITE_NAME=nextgen.localhost
PUBLIC_URL=http://localhost:8180
HTTP_PORT=8180

# Fill these only when enabling the optional production HTTPS profile.
ERP_DOMAIN=
ACME_EMAIL=

DB_ROOT_PASSWORD=CHANGE_ME_LONG_RANDOM_DATABASE_PASSWORD
ADMIN_PASSWORD=CHANGE_ME_LONG_RANDOM_ERPNEXT_PASSWORD

# Create a dedicated ERPNext API user after the first startup, then enter its keys.
ERPNEXT_API_KEY=
ERPNEXT_API_SECRET=
ERPNEXT_WAREHOUSE=Stores - NG

# Generate a different long random value and also save it in NextGen Automation Settings.
ORDER_INTAKE_API_KEY=CHANGE_ME_LONG_RANDOM_INTAKE_KEY

# Keep these values for the ERPNext-first architecture.
ORDER_BACKEND=erpnext
LINE_CONFIG_SOURCE=erpnext
LINE_WORKFLOW_BACKEND=erpnext
ERPCLAW_BACKEND=erpnext
