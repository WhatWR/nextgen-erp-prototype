# Copy to .env. Never commit real secrets.
ERPNEXT_URL=http://127.0.0.1:8000
ERPNEXT_API_KEY=
ERPNEXT_API_SECRET=
ERPNEXT_WAREHOUSE=Stores - NG
ORDER_INTAKE_API_KEY=

ORDER_BACKEND=erpnext
LINE_CONFIG_SOURCE=erpnext
LINE_WORKFLOW_BACKEND=erpnext
ERPCLAW_BACKEND=erpnext
ORDER_INTAKE_PORT=8200

# LINE AI assistant fallbacks. Values saved in the NextGen AI Settings DocType
# (Desk) take precedence; the same OpenAI-compatible credentials can be used by
# Typhoon Staff Chat. Both https://api.opentyphoon.ai and .../v1 are accepted.
AI_GATEWAY_URL=
AI_GATEWAY_API_KEY=
AI_CHAT_MODEL=
AI_EMBEDDINGS_MODEL=
# AI_ASSISTANT_ENABLED=1 only enables the assistant when ERPNext settings are unreachable.
AI_ASSISTANT_ENABLED=

# Local paths may differ.
BENCH_DIR=/Users/santi/nextgen-bench
# ENABLE_LEGACY_PROTOTYPE must stay unset in ERPNext-first deployments.
